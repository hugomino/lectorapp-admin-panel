SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Contraseña única para entrar al panel (no hay usuarios ni Supabase Auth).
ADMIN_PANEL_PASSWORD=

# Secreto usado para firmar la cookie de sesión. Genera uno largo y aleatorio,
# por ejemplo con: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Opcional. UUID de un perfil (public.profiles.id) para dejar constancia de
# quién verificó/rechazó cada libro en book_review_log.processed_by. Si se
# deja vacío, processed_by se guarda como NULL.
ADMIN_USER_ID=
